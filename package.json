{
  "name": "stringflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.json *.ts *.html README.md .github/workflows/ci.yml",
    "format:check": "prettier --check src tests e2e *.json *.ts *.html README.md .github/workflows/ci.yml"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
